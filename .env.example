# Google AI Studio API key (server-side only — never prefix with NEXT_PUBLIC_)
# Get one at https://aistudio.google.com/apikey and copy this file to .env.local
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional per-IP rate limit for /api/generate (best-effort, in-memory per instance).
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW_MS=60000

# Vercel Production must use a SEPARATE production-only key (never reuse the dev key).

# UIFORGE_E2E_MOCK=1 is TEST-ONLY (Playwright/CI uses a fixed mock model, no API key).
# Never set it on Vercel; it is ignored when VERCEL_ENV=production.
